# ==============================================================================
# MQTech Website — Environment Configuration Template (.env.example)
# DO NOT COMMIT REAL SECRETS OR SENSITIVE PASSWORDS TO SOURCE CONTROL
# ==============================================================================

# Public Application URL (Used for metadata, canonical links, and redirect URLs)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Target Service Area (Buôn Ma Thuột and surrounding ~15 km radius)
NEXT_PUBLIC_SERVICE_AREA="Buôn Ma Thuột và khu vực lân cận (~15 km)"

# Deployment Environment Label ("development" | "staging" | "production" | "test")
MQTECH_DEPLOYMENT_ENV="development"

# Trusted Origin for CSRF protection and CORS verification
MQTECH_PUBLIC_ORIGIN="http://localhost:3000"

# PostgreSQL Database Connection URL (Server-side only)
# For runtime Web app: uses least-privilege DML user (mqtech_app)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=prefer
DATABASE_URL="postgresql://mqtech_app:change_me_local_pass@localhost:5432/mqtech?sslmode=disable"

# Admin Authentication Secret (Used for signing administrative session cookies)
# Minimum 32 characters in production. Generate with: openssl rand -base64 32
ADMIN_SESSION_SECRET="change-this-to-a-secure-random-32-byte-secret-in-production-32b"

# Initial Admin Bootstrap Password (used by scripts/bootstrap-admin.mjs)
ADMIN_INIT_PASSWORD="temporary-admin-bootstrap-password"

# Node Environment
NODE_ENV="development"

# Explicit in-memory store toggle (ONLY allowed in development with explicit true)
ALLOW_MEMORY_STORE="false"

# ==============================================================================
# Cloudflare R2 Object Storage (Three Distinct Buckets Architecture)
# ==============================================================================
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_s3_compatible_access_key_id"
R2_SECRET_ACCESS_KEY="your_s3_compatible_secret_access_key"

# 1. Public Media Bucket (Marketing assets, public icons)
R2_MEDIA_BUCKET="mqtech-media-staging"
MEDIA_PUBLIC_BASE_URL="https://pub-staging.r2.dev"

# 2. Strictly Private Attachments Bucket (Customer equipment photos, serials)
# NO public URL, NO r2.dev domain. Accessible ONLY via authenticated admin presigned GET (300s)
R2_ATTACHMENTS_BUCKET="mqtech-attachments-staging"

# 3. Strictly Private Database Backups Bucket (Encrypted database dumps)
# NO public access, client direct PUT/GET strictly forbidden
R2_BACKUP_BUCKET="mqtech-db-backups-staging"
