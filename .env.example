# PostgreSQL Connection (Fly.io Postgres hoặc Neon/Supabase)
# Để trống khi chạy dev local -> tự động dùng PGlite lưu trong .pglite-data
DATABASE_URL=

# (Tùy chọn) PostgreSQL dự phòng để đồng bộ Backup 1 chạm từ /admin/cai-dat (VD: Supabase hoặc Neon thứ 2)
BACKUP_DATABASE_URL=

# Bảo mật phiên đăng nhập Admin (hãy đổi chuỗi ngẫu nhiên dài >= 32 ký tự khi deploy)
JWT_SECRET=change-me-to-a-long-random-secret-key

# Tài khoản Admin khởi tạo lần đầu
ADMIN_EMAIL=manhquang89@gmail.com
ADMIN_PASSWORD=MQTech@2026

# Tên miền chính thức (khi mua domain gắn vào để đồng bộ Sitemap & SEO)
NEXT_PUBLIC_SITE_URL=

# Cloudflare R2 Object Storage (Upload ảnh dịch vụ & bài viết)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
# Đặt thành true khi R2_PUBLIC_URL gắn qua custom domain đã bật Cloudflare Image Transformations
NEXT_PUBLIC_CF_IMAGE_RESIZING=false
